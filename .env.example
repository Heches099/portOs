BACKED_APP_NAME=PortOS Backed
BACKED_API_VERSION=1.0.0
BACKED_FIREBASE_PROJECT_ID=your-firebase-project-id
BACKED_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Either point at a committed/local JSON file...
BACKED_FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...or provide a base64-encoded copy (recommended for Render, since the JSON is gitignored).
# Generate with:  certutil -encode firebase-service-account.json sa.b64  (or base64 on POSIX)
BACKED_FIREBASE_SERVICE_ACCOUNT_B64=
BACKED_ADMIN_EMAILS=admin@portos.io
# Must include your Vercel frontend origin in production.
BACKED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://portos-nextgen.vercel.app
BACKED_INGEST_API_KEY=replace-with-a-long-random-secret
BACKED_PASSWORD_RESET_CONTINUE_URL=http://localhost:3000/login
